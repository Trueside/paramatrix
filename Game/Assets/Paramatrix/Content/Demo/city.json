    { "id": "event.exit_nii_entrance", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.nii_entrance"}], "actions": [{"action": "transition", "location": "location.office", "entry": "from_street"}] },
    { "id": "response.inspect_nii_entrance", "tier": "specific", "interaction": "inspect", "target": "object.nii_entrance", "text": "Стеклянные двери НИИ кибернетики. Внутри горит дежурный свет." },
    { "id": "event.exit_hall_east_edge", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.hall_east_edge"}], "actions": [{"action": "transition", "location": "location.nii_street", "entry": "from_west"}] },
    { "id": "response.inspect_hall_east_edge", "tier": "specific", "interaction": "inspect", "target": "object.hall_east_edge", "text": "Улица тянется дальше, к НИИ." },
    { "id": "event.exit_nii_west_edge", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.nii_west_edge"}], "actions": [{"action": "transition", "location": "location.hall", "entry": "from_east"}] },
    { "id": "response.inspect_nii_west_edge", "tier": "specific", "interaction": "inspect", "target": "object.nii_west_edge", "text": "Там жилые дома." },
    { "id": "event.exit_nii_east_edge", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.nii_east_edge"}], "actions": [{"action": "transition", "location": "location.dk_street", "entry": "from_west"}] },
    { "id": "response.inspect_nii_east_edge", "tier": "specific", "interaction": "inspect", "target": "object.nii_east_edge", "text": "Дальше по улице — Дом культуры." },
    { "id": "event.exit_dk_west_edge", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.dk_west_edge"}], "actions": [{"action": "transition", "location": "location.nii_street", "entry": "from_east"}] },
    { "id": "response.inspect_dk_west_edge", "tier": "specific", "interaction": "inspect", "target": "object.dk_west_edge", "text": "Обратно к НИИ." },
    { "id": "event.exit_dk_east_edge", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.dk_east_edge"}], "actions": [{"action": "transition", "location": "location.factory_street", "entry": "from_west"}] },
    { "id": "response.inspect_dk_east_edge", "tier": "specific", "interaction": "inspect", "target": "object.dk_east_edge", "text": "За поворотом дымят трубы завода." },
    { "id": "event.exit_dk_entrance", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.dk_entrance"}], "actions": [{"action": "transition", "location": "location.bar", "entry": "from_street"}] },
    { "id": "response.inspect_dk_entrance", "tier": "specific", "interaction": "inspect", "target": "object.dk_entrance", "text": "Двери Дома культуры. Изнутри доносится музыка." },
    { "id": "event.exit_bar_curtain", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.bar_curtain"}], "actions": [{"action": "transition", "location": "location.dk_street", "entry": "from_bar"}] },
    { "id": "response.inspect_bar_curtain", "tier": "specific", "interaction": "inspect", "target": "object.bar_curtain", "text": "Занавеска из бусин. За ней — выход на улицу." },
    { "id": "event.exit_factory_west_edge", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.factory_west_edge"}], "actions": [{"action": "transition", "location": "location.dk_street", "entry": "from_east"}] },
    { "id": "response.inspect_factory_west_edge", "tier": "specific", "interaction": "inspect", "target": "object.factory_west_edge", "text": "Обратно к Дому культуры." },
    { "id": "event.exit_factory_gates", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.factory_gates"}], "actions": [{"action": "transition", "location": "location.shop_street", "entry": "from_factory"}] },
    { "id": "response.inspect_factory_gates", "tier": "specific", "interaction": "inspect", "target": "object.factory_gates", "text": "Ворота завода №7. Приоткрыты." },
    { "id": "event.exit_shop_gates", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.shop_gates"}], "actions": [{"action": "transition", "location": "location.factory_street", "entry": "from_shop"}] },
    { "id": "response.inspect_shop_gates", "tier": "specific", "interaction": "inspect", "target": "object.shop_gates", "text": "Ворота обратно, на улицу." },
    { "id": "event.exit_shop_door", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.shop_door"}], "actions": [{"action": "transition", "location": "location.workshop", "entry": "from_street"}] },
    { "id": "response.inspect_shop_door", "tier": "specific", "interaction": "inspect", "target": "object.shop_door", "text": "Дверь в цех. Над ней горит лампа." },
    { "id": "event.exit_workshop_door", "execution": "exclusive", "repeat": "repeatable", "triggers": [{"type": "interaction", "interaction": "exit", "target": "object.workshop_door"}], "actions": [{"action": "transition", "location": "location.shop_street", "entry": "from_workshop"}] },
    { "id": "response.inspect_workshop_door", "tier": "specific", "interaction": "inspect", "target": "object.workshop_door", "text": "Двери во двор завода." },
    { "id": "response.workshop_upper_door", "tier": "specific", "interaction": "exit", "target": "object.workshop_upper_door", "text": "Заперто изнутри. Наверх так не попасть." },
    { "id": "response.inspect_workshop_upper_door", "tier": "specific", "interaction": "inspect", "target": "object.workshop_upper_door", "text": "Дверь на галерее. Табличка стёрта." }
  ]
}
