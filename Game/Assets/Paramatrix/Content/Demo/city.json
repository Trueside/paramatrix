{
  "format_version": 1,
  "definitions": [
    { "id": "location.nii_street", "scene": "Location_NiiStreet" },
    { "id": "location.dk_street", "scene": "Location_DkStreet" },
    { "id": "location.bar", "scene": "Location_Bar" },
    { "id": "character.beautiful_girl", "name": "Красавица", "initial_location": "location.bar", "primary_interaction": "talk", "emotions": ["default", "embarrassed", "smirk"] },
    {
      "id": "dialogue.bar_girl",
      "mode": "normal",
      "lines": [
        { "speaker": "character.beautiful_girl", "text": "Не часто сюда заходят такие, как ты." },
        { "speaker": "character.paranoik", "text": "Такие — это какие?" },
        { "speaker": "character.beautiful_girl", "text": "Те, кто оглядывается на каждую тень." },
        { "choice": [
          { "label": "Отшутиться", "lines": [ { "speaker": "character.paranoik", "text": "Тени тоже иногда оглядываются." }, { "speaker": "character.beautiful_girl", "text": "Смешно. Мне нравится." } ] },
          { "label": "Признаться", "lines": [ { "speaker": "character.paranoik", "text": "За мной правда следят." }, { "speaker": "character.beautiful_girl", "text": "Здесь никто никого не ищет. Расслабься." } ] }
        ] },
        { "speaker": "character.beautiful_girl", "text": "Я давно за тобой наблюдаю." },
        { "speaker": "character.beautiful_girl", "text": "Хочешь узнать друг друга лучше?" },
        { "choice": [
          { "label": "Да", "lines": [ { "speaker": "character.paranoik", "text": "Да. Я давно хотел этого." } ], "next": "dialogue.bar_girl_novel" },
          { "label": "Мне пора", "lines": [ { "speaker": "character.paranoik", "text": "В другой раз." }, { "speaker": "character.beautiful_girl", "text": "Как знаешь." } ], "end": true }
        ] }
      ]
    },
    {
      "id": "dialogue.bar_girl_novel",
      "mode": "novel",
      "partner": "character.beautiful_girl",
      "lines": [
        { "speaker": "character.beautiful_girl", "text": "Вот так. Теперь здесь только мы." },
        { "speaker": "character.paranoik", "text": "Бар куда-то исчез." },
        { "speaker": "character.beautiful_girl", "text": "Не исчез. Ты просто перестал его замечать.", "emotion": "smirk" },
        { "choice": [
          { "label": "Сделать комплимент", "lines": [ { "speaker": "character.paranoik", "text": "У тебя удивительные глаза." }, { "speaker": "character.beautiful_girl", "text": "Ты первый, кто посмотрел в них дольше секунды.", "emotion": "embarrassed" } ] },
          { "label": "Спросить, кто она", "lines": [ { "speaker": "character.paranoik", "text": "Кто ты?" }, { "speaker": "character.beautiful_girl", "text": "Та, кого ты не ожидал встретить.", "emotion": "smirk" } ] }
        ] },
        { "speaker": "character.beautiful_girl", "text": "Мне пора. Но мы ещё увидимся." },
        { "choice": [
          { "label": "Подожди", "lines": [ { "speaker": "character.paranoik", "text": "Подожди…" }, { "speaker": "character.beautiful_girl", "text": "Не торопи сон." } ] },
          { "label": "До встречи", "lines": [ { "speaker": "character.paranoik", "text": "До встречи." } ] }
        ] }
      ]
    },
    { "id": "event.talk_beautiful_girl", "execution": "exclusive", "repeat": "repeatable", "triggers": [ { "type": "interaction", "interaction": "talk", "target": "character.beautiful_girl" } ], "actions": [ { "action": "dialogue", "dialogue": "dialogue.bar_girl" } ] },
    { "id": "response.inspect_beautiful_girl", "tier": "specific", "interaction": "inspect", "target": "character.beautiful_girl", "text": "Чёрный костюм, золотые серьги. Смотрит так, будто давно меня ждёт." },
    { "id": "location.factory_street", "scene": "Location_FactoryStreet" },
    { "id": "location.shop_street", "scene": "Location_ShopStreet" },
    { "id": "location.workshop", "scene": "Location_Workshop" },
