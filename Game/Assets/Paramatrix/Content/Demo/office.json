{
  "format_version": 1,
  "definitions": [
    { "id": "location.office", "scene": "Location_Office" },
    { "id": "location.corridor", "scene": "Location_Corridor" },

    {
      "id": "story.office",
      "states": {
        "intro_done": { "type": "boolean", "default": false, "persistence": "persistent", "mutation_policy": "scenario_only" }
      }
    },

    {
      "id": "object.office_door",
      "primary_interaction": "exit",
      "states": {
        "locked": { "type": "boolean", "default": true, "persistence": "persistent", "mutation_policy": "scenario_only" }
      }
    },
    { "id": "object.office_poster", "primary_interaction": "primary" },
    { "id": "object.corridor_door", "primary_interaction": "exit" },

    { "id": "item.key", "name": "Ключ", "description": "Маленький латунный ключ.", "initial_holder": "location.office" },

    { "id": "character.trinity", "name": "Тринити", "initial_location": "location.office", "primary_interaction": "talk", "emotions": ["default"] },

    {
      "id": "condition.door_is_locked",
      "condition": { "target": "object.office_door", "property": "locked", "operator": "equals", "value": true }
    },

    {
      "id": "dialogue.trinity",
      "mode": "normal",
      "lines": [
        { "speaker": "character.trinity", "text": "Ты ведь чувствуешь это?" },
        { "speaker": "character.paranoik", "text": "Что именно?" },
        { "speaker": "character.trinity", "text": "Что мир — не то, чем кажется." }
      ]
    },

    {
      "id": "event.intro",
      "execution": "exclusive",
      "repeat": "once",
      "triggers": [ { "type": "location_entered", "location": "location.office" } ],
      "launch_condition": { "target": "story.office", "property": "intro_done", "operator": "equals", "value": false },
      "actions": [
        { "action": "say", "speaker": "character.paranoik", "text": "Опять этот офис." },
        { "action": "set_state", "target": "story.office", "property": "intro_done", "value": true }
      ]
    },

    {
      "id": "event.take_key",
      "execution": "exclusive",
      "repeat": "once",
      "triggers": [ { "type": "interaction", "interaction": "take", "target": "item.key" } ],
      "actions": [
        { "action": "animation", "target": "character.paranoik", "clip": "bend_down" },
        { "action": "inventory", "item": "item.key", "to": "inventory" }
      ]
    },

    {
      "id": "event.unlock_door",
      "execution": "exclusive",
      "repeat": "once",
      "triggers": [ { "type": "interaction", "interaction": "apply_item", "target": "object.office_door", "item": "item.key" } ],
      "launch_condition": { "ref": "condition.door_is_locked" },
      "actions": [
        { "action": "set_state", "target": "object.office_door", "property": "locked", "value": false },
        { "action": "inventory", "item": "item.key", "to": "consumed" },
        { "action": "clear_selection" }
      ]
    },

    {
      "id": "event.exit_office",
      "execution": "exclusive",
      "repeat": "repeatable",
      "triggers": [ { "type": "interaction", "interaction": "exit", "target": "object.office_door" } ],
      "launch_condition": { "not": { "ref": "condition.door_is_locked" } },
      "actions": [ { "action": "transition", "location": "location.corridor", "entry": "from_office" } ]
    },

    {
      "id": "event.back_to_office",
      "execution": "exclusive",
      "repeat": "repeatable",
      "triggers": [ { "type": "interaction", "interaction": "exit", "target": "object.corridor_door" } ],
      "actions": [ { "action": "transition", "location": "location.office", "entry": "from_corridor" } ]
    },

    {
      "id": "event.talk_trinity",
      "execution": "exclusive",
      "repeat": "repeatable",
      "triggers": [ { "type": "interaction", "interaction": "talk", "target": "character.trinity" } ],
      "launch_condition": { "not": { "ref": "condition.met_morpheus" } },
      "actions": [ { "action": "dialogue", "dialogue": "dialogue.trinity" } ]
    },
    {
      "id": "event.talk_trinity_after_morpheus",
      "execution": "exclusive",
      "repeat": "repeatable",
      "triggers": [ { "type": "interaction", "interaction": "talk", "target": "character.trinity" } ],
      "launch_condition": { "ref": "condition.met_morpheus" },
      "actions": [ { "action": "dialogue", "dialogue": "dialogue.trinity_after_morpheus" } ]
    },
    {
      "id": "dialogue.trinity_after_morpheus",
      "mode": "normal",
      "lines": [
        { "speaker": "character.trinity", "text": "Ты его видел. По глазам вижу." },
        { "speaker": "character.paranoik", "text": "Он сказал, что всё это — не настоящее." }
      ]
    },

    { "id": "response.door_locked", "tier": "specific", "interaction": "exit", "target": "object.office_door", "condition": { "ref": "condition.door_is_locked" }, "text": "Заперто." },
    { "id": "response.poster", "tier": "specific", "interaction": "primary", "target": "object.office_poster", "text": "Паутина из шестиугольников. Не помню, когда я её повесил." },
    {
      "id": "response.inspect_poster",
      "tier": "specific",
      "interaction": "inspect",
      "target": "object.office_poster",
      "lines": [
        "Линии сходятся в центре, как будто там кто-то сидит.",
        "Если долго смотреть, шестиугольники начинают шевелиться."
      ]
    },
    { "id": "response.poster_stub_1", "tier": "generic", "interaction": "inspect", "target": "object.office_poster", "text": "Просто постер." },
    { "id": "response.poster_stub_2", "tier": "generic", "interaction": "inspect", "target": "object.office_poster", "text": "Хватит на него пялиться." }
  ]
}
